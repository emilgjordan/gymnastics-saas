# Postgres connection string
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Public URL of the app (used for auth callbacks and invite links)
ORIGIN="http://localhost:5173"

# Better Auth — use 32+ random characters in production, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Optional: GitHub sign-in. Leave blank to only offer email + password.
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
